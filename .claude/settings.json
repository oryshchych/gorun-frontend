{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git remote -v:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run start:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run type-check\\:tests:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint\\:fix:*)",
      "Bash(npm run format:*)",
      "Bash(npm run format\\:check:*)",
      "Bash(npm run format\\:staged:*)",
      "Bash(npm run test:*)",
      "Bash(npm run test\\:watch:*)",
      "Bash(npm run test\\:ui:*)",
      "Bash(npm test:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Edit(/.claude/skills/add-translation-key/**)",
      "Edit(/.claude/skills/scaffold-form/**)",
      "Edit(/.claude/skills/scaffold-locale-page/**)",
      "Edit(/.claude/skills/add-api-endpoint/**)",
      "Edit(/.claude/skills/add-shadcn-primitive/**)",
      "Edit(/.claude/skills/write-vitest-test/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npm publish:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" =~ \\.(ts|tsx|js|jsx|json|md|mdx|css)$ ]]; then npx --no-install prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '→ Before commit: npm run type-check && npm run lint && npm test'"
          }
        ]
      }
    ]
  }
}
